{
 "name": "Notes – Kidebouchetou.com",
 "short_name": "Notes Kidebouchetou",
 "start_url": "./index.html",
 "scope": "./",
 "display": "standalone",
 "background_color": "#f6f7f9",
 "theme_color": "#0b6e6a",
 "lang": "fr",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any maskable"
  }
 ],
 "share_target": {
  "action": "./index.html?share=files",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "title": "title",
   "text": "text",
   "url": "url",
   "files": [
    {
     "name": "files",
     "accept": [
      "image/*",
      "video/*",
      "audio/*",
      "application/pdf",
      ".doc",
      ".docx",
      ".xls",
      ".xlsx",
      ".txt",
      ".csv"
     ]
    }
   ]
  }
 }
}